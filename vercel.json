
{
  "services": {
    "web": {
      "root": "frontend/"
    },
    "api": {
      "root": "./",
      "entrypoint": "backend.main:app",
      "rewrites": [
        {
          "source": "/api",
          "destination": "/"
        },
        {
          "source": "/api/:path*",
          "destination": "/:path*"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
